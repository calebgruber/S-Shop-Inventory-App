{
  "name": "s-shop-inventory-app",
  "version": "1.0.0",
  "description": "CMFT Sound Shop Inventory - Theatre Sound Equipment Management System",
  "main": "src/main.js",
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "postinstall": "electron-builder install-app-deps || echo 'Skipping native rebuild - will use prebuilt binaries'"
  },
  "keywords": [
    "electron",
    "inventory",
    "theatre",
    "sound",
    "barcode",
    "sqlite"
  ],
  "author": "CMFT",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "electron": "^27.0.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "better-sqlite3": "^12.6.2",
    "canvas": "^2.11.2",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.7.3",
    "jsbarcode": "^3.11.6",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "quagga": "^0.6.16"
  },
  "overrides": {
    "better-sqlite3": "$better-sqlite3"
  },
  "optionalDependencies": {
    "@electron/rebuild": "^3.6.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "S-Shop Inventory",
        "executableName": "s-shop-inventory",
        "icon": "assets/icon",
        "asar": true
      },
      "publishers": [
        {
          "name": "@electron-forge/publisher-github",
          "config": {
            "repository": {
              "owner": "calebgruber",
              "name": "S-Shop-Inventory-App"
            },
            "prerelease": false,
            "draft": false
          }
        }
      ],
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "s_shop_inventory",
            "setupIcon": "assets/icon.ico"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin",
            "linux"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {
            "options": {
              "maintainer": "CMFT",
              "homepage": "https://github.com/calebgruber/S-Shop-Inventory-App"
            }
          }
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {
            "options": {
              "homepage": "https://github.com/calebgruber/S-Shop-Inventory-App"
            }
          }
        }
      ],
      "plugins": [
        {
          "name": "@electron-forge/plugin-auto-unpack-natives",
          "config": {
            "electronVersion": "27.0.0"
          }
        }
      ],
      "rebuildConfig": {
        "force": false,
        "onlyModules": ["better-sqlite3"]
      }
    }
  }
}
